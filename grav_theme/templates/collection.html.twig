{% extends 'partials/base.html.twig' %}
{% block content %}
<article class="spip-collection">
	<h1>{{ page.title|e }}</h1>
	<ul>
	{% for c in page.children.published.order('title', 'asc') %}
		<li><a href="{{ c.url }}">{{ c.title|e }}</a>{% if c.header.date %} <time>{{ c.date|date('d/m/Y') }}</time>{% endif %}</li>
	{% endfor %}
	</ul>
</article>
{% endblock %}
